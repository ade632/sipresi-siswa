APP_NAME="SIPRESI SISWA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipresi_siswa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# ==== PENGATURAN SIPRESI SISWA ====
SEKOLAH_NAMA="SMK Negeri 1 Rejang Lebong"
SEKOLAH_LATITUDE=-3.4700
SEKOLAH_LONGITUDE=102.6800
SEKOLAH_RADIUS_METER=100
JAM_MASUK="07:00"
JAM_MASUK_TERLAMBAT="07:15"
JAM_PULANG="15:30"

# ==== FIREBASE CLOUD MESSAGING (Push Notification) ====
# Unduh service-account.json dari Firebase Console > Project Settings > Service Accounts
# lalu letakkan di storage/app/firebase/service-account.json
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
